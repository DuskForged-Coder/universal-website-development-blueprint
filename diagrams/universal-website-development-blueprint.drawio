          <mxGeometry height="80" width="940" x="430" y="20" as="geometry" />
        </mxCell>
        <mxCell id="surface" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;fontSize=14;spacing=9;" value="&lt;b&gt;ATTACK SURFACE&lt;/b&gt;&lt;br&gt;Browser • APIs • admin • integrations • uploads • infrastructure • developer pipeline" vertex="1">
          <mxGeometry height="80" width="700" x="550" y="140" as="geometry" />
        </mxCell>
        <mxCell id="identity" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=15;fontStyle=1;spacing=10;" value="&lt;b&gt;IDENTITY&lt;/b&gt;&lt;br&gt;Registration • MFA (risk-based) • password hashing • session lifecycle • account recovery" vertex="1">
          <mxGeometry height="115" width="360" x="80" y="310" as="geometry" />
        </mxCell>
        <mxCell id="access" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=15;fontStyle=1;spacing=10;" value="&lt;b&gt;ACCESS CONTROL&lt;/b&gt;&lt;br&gt;RBAC / ABAC • least privilege • tenant isolation • server-side checks • admin separation" vertex="1">
          <mxGeometry height="115" width="360" x="500" y="310" as="geometry" />
        </mxCell>
        <mxCell id="input" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=15;fontStyle=1;spacing=10;" value="&lt;b&gt;APPLICATION DEFENSE&lt;/b&gt;&lt;br&gt;Input validation • output encoding • injection defense • CSRF • XSS • SSRF controls" vertex="1">
          <mxGeometry height="115" width="360" x="920" y="310" as="geometry" />
        </mxCell>
        <mxCell id="edge" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D97706;fontColor=#78350F;fontSize=15;fontStyle=1;spacing=10;" value="&lt;b&gt;EDGE &amp; NETWORK&lt;/b&gt;&lt;br&gt;TLS • WAF • DDoS controls • rate limits • secure headers • network segmentation" vertex="1">
