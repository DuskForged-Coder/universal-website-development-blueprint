  <diagram id="guide" name="07 - How to Use">
    <mxGraphModel dx="2074" dy="2397" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;fontSize=14;spacing=9;" value="HOW TO USE THIS BLUEPRINT&lt;br&gt;&lt;font style=&#39;font-size:13px;font-weight:normal&#39;&gt;A practical method for adapting the architecture to projects of different sizes&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="960" x="170" y="-250" as="geometry" />
        </mxCell>
        <mxCell id="step1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D97706;fontColor=#78350F;fontSize=15;fontStyle=1;spacing=10;" value="&lt;b&gt;1. DISCOVER&lt;/b&gt;&lt;br&gt;Identify users, business outcomes, workflows, data types, integrations, constraints and compliance needs." vertex="1">
          <mxGeometry height="120" width="480" x="410" y="-130" as="geometry" />
        </mxCell>
        <mxCell id="step2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;fontSize=14;spacing=9;" value="&lt;b&gt;2. CLASSIFY&lt;/b&gt;&lt;br&gt;Mark each module as Required / Optional / Not Needed. Record why optional modules are included." vertex="1">
          <mxGeometry height="120" width="480" x="410" y="70" as="geometry" />
        </mxCell>
        <mxCell id="step3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE8FF;strokeColor=#7C3AED;fontColor=#2E1065;fontSize=15;fontStyle=1;spacing=10;" value="&lt;b&gt;3. DESIGN&lt;/b&gt;&lt;br&gt;Choose architecture style, trust boundaries, data model, API contracts, failure modes and deployment topology." vertex="1">
          <mxGeometry height="120" width="480" x="420" y="250" as="geometry" />
        </mxCell>
        <mxCell id="step4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FF;strokeColor=#0891B2;fontColor=#083344;fontSize=15;fontStyle=1;spacing=10;" value="&lt;b&gt;4. BUILD&lt;/b&gt;&lt;br&gt;Implement vertical slices: user journey → UI → API → data → tests → telemetry." vertex="1">
          <mxGeometry height="120" width="480" x="420" y="435" as="geometry" />
        </mxCell>
        <mxCell id="step5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=15;fontStyle=1;spacing=10;" value="&lt;b&gt;5. VERIFY&lt;/b&gt;&lt;br&gt;Test function, security, accessibility, performance, recovery, privacy and operational readiness." vertex="1">
          <mxGeometry height="120" width="480" x="420" y="625" as="geometry" />
        </mxCell>
        <mxCell id="step6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D97706;fontColor=#78350F;fontSize=15;fontStyle=1;spacing=10;" value="&lt;b&gt;6. OPERATE &amp; EVOLVE&lt;/b&gt;&lt;br&gt;Monitor real usage, incidents and cost. Refactor or scale only when evidence justifies it." vertex="1">
          <mxGeometry height="120" width="480" x="420" y="820" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;fontSize=14;spacing=9;" value="&lt;b&gt;COLOR KEY&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#0891B2&#39;&gt;■ Frontend / UX&lt;/font&gt; &amp;nbsp; &lt;font color=&#39;#7C3AED&#39;&gt;■ Backend&lt;/font&gt; &amp;nbsp; &lt;font color=&#39;#16A34A&#39;&gt;■ Data&lt;/font&gt; &amp;nbsp; &lt;font color=&#39;#D97706&#39;&gt;■ Operations&lt;/font&gt; &amp;nbsp; &lt;font color=&#39;#DC2626&#39;&gt;■ Security&lt;/font&gt; &amp;nbsp; &lt;font color=&#39;#DB2777&#39;&gt;■ External services&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="700" x="330" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="principle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;fontSize=14;spacing=9;" value="&lt;b&gt;SCALING PRINCIPLE&lt;/b&gt;&lt;br&gt;Complexity is earned by requirements. A simple brochure site may need static pages and a contact form; a multi-tenant SaaS may need queues, audit trails, tenant isolation, observability and formal recovery targets." vertex="1">
          <mxGeometry height="100" width="800" x="290" y="1180" as="geometry" />
        </mxCell>
